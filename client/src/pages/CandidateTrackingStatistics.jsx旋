                                <div className="flex items-baseline gap-2 mt-1">
                                    <span className="text-4xl font-black text-slate-900 dark:text-white leading-none">
                                        {averageMatch}%
                                    </span>
                                    <span className="text-[10px] font-bold text-emerald-600">Candidate Quality</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    );
};

