# =============================================================
# stage.io — front-end environment
# Copy to `.env.production` (or `.env`) and adapt before building.
# =============================================================

# Base URL of the back-end API. Used by `src/services/http.js`.
# - Leave empty for local browser dev (Vite proxy handles `/api/...`).
# - For Android emulator: http://10.0.2.2:3000
# - For iOS simulator:    http://localhost:3000
# - For a real phone on the LAN: http://<your-laptop-ip>:3000
# - For production: https://api.stage.io
VITE_API_BASE=
